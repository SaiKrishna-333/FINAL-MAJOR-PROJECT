# ================================================================
# Hardhat / contract deployment. Copy this file to .env inside
# blockchain/ before `npx hardhat run scripts/deploy.js --network polygonAmoy`.
# ================================================================

# rpc-amoy.polygon.technology has been unreliable (DNS failures);
# publicnode was verified working from this machine.
POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# Deployer wallet. Must be the SAME account as backend/.env's
# WALLET_PRIVATE_KEY, because the deployed contract grants that address
# owner/admin rights. Needs testnet POL (Amoy faucet) before deploy will
# pay gas.
WALLET_PRIVATE_KEY=
