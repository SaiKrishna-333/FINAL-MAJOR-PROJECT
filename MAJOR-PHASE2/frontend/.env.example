# ================================================================
# Frontend configuration. Copy this file to .env before `npm run dev`
# or `npm run build`. Vite only exposes variables whose name starts
# with VITE_.
# ================================================================

# Where the backend lives (REST + Socket.IO both use this single origin).
# Leave it out and the app falls back to http://localhost:5000.
VITE_API_URL=http://localhost:5000
