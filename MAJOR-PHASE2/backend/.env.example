# ================================================================
# Backend configuration. Copy this file to .env and fill in values.
# Every optional block is labelled - the server starts without them
# and degrades honestly (features report "not configured" instead of
# pretending to work).
# ================================================================

# --- Required ---
PORT=5000
MONGO_URI=mongodb://localhost:27017/BioChainRTO
# Generate your own secret; anything that signs logins is a secret.
JWT_SECRET=change-me-to-a-long-random-string

# --- Blockchain anchoring (Polygon Amoy testnet) ---
# rpc-amoy.polygon.technology has been unreliable (DNS failures); the
# publicnode and tenderly endpoints below were verified working.
POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
POLYGON_RPC_BACKUP1=https://polygon-amoy.gateway.tenderly.co
POLYGON_RPC_BACKUP2=https://polygon-amoy.g.alchemy.com/v2/demo
POLYGONSCAN_BASE_URL=https://amoy.polygonscan.com
# Deployment from blockchain/scripts/deploy.js (public, safe to commit)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Wallet that signs anchor transactions. NEEDS A FUNDED TESTNET ACCOUNT:
# a wallet with 0 POL cannot pay the 25 gwei minimum priority fee, so
# records stay honestly marked "pending" instead of claiming a tx hash.
WALLET_PRIVATE_KEY=
# Optional: override the gas caps computed from the RPC at runtime
# ANCHOR_MAX_FEE_PER_GWEI=30

# --- Optional: Pinata IPFS (document storage) ---
# Without these, uploads land in the local content-addressed vault under
# backend/uploads/documents/ and are still verified by SHA-256 on read.
# PINATA_API_KEY=
# PINATA_SECRET_KEY=
# IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# IPFS_LOCAL_URL=http://localhost:5001/api/v0/add

# --- Optional: email notifications ---
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=
# BACKEND_PUBLIC_URL=http://localhost:5000

# --- Optional: SMS (Twilio) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# --- Optional: biometric SDKs (hardware scanners) ---
# Without a SDK path the app uses its built-in simulation path.
# BIOMETRIC_SALT=
# BIOMETRIC_SDK_PROVIDER=
# SECUGEN_SDK_PATH=
# SECUGEN_DEVICE_ID=
# MANTRA_SDK_PATH=
# MANTRA_PORT=
# MORPHO_SDK_PATH=
# MORPHO_DEVICE_ID=
# DIGITAL_PERSONA_SDK_PATH=
# DIGITAL_PERSONA_DEVICE_ID=
